local function executorName()
    local n = ""
    pcall(function() if identifyexecutor then n = select(1, identifyexecutor()) or "" end end)
    if n == "" then pcall(function() if getexecutorname then n = getexecutorname() or "" end end) end
    return string.lower(tostring(n))
end

local function isLowUNC()
    local n = executorName()
    if n:find("xeno") or n:find("solara") then return true end
    local score = 0
    pcall(function() if type(getconnections) == "function" then score += 2 end end)
    pcall(function() if type(hookmetamethod) == "function" then score += 1 end end)
    pcall(function()
        if (syn and type(syn.request) == "function") or type(http_request) == "function"
            or (fluxus and type(fluxus.request) == "function") or (delta and type(delta.request) == "function")
        then score += 1 end
    end)
    return score <= 1
end

