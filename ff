                startPos = card.Position
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType == Enum.UserInputType.MouseMovement
                or inp.UserInputType == Enum.UserInputType.Touch then
                local d = inp.Position - start
                card.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    closeBtn.MouseButton1Click:Connect(function()
        if not State.Loaded and not State.Active then
            setStatus("wait til it finishes", Theme.Warn)
            return
        end
        TweenService:Create(card, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
        task.delay(0.3, function() pcall(function() gui:Destroy() end) end)
        notify("ui closed, script still running", 3)
    end)

    setStatus = function(msg, col)
        if UI.Status then UI.Status.Text = msg; UI.Status.TextColor3 = col or Theme.Dim end
    end

    setButton = function(txt, enabled)
        if not UI.Action then return end
        UI.Action.Text = txt
        UI.Action.Active = enabled ~= false
        if State.Active then
            UI.Action.BackgroundColor3 = Theme.Good
            UI.Action.TextColor3 = Color3.new(1, 1, 1)
        elseif State.Loaded or State.Loading then
            UI.Action.BackgroundColor3 = Theme.Card
            UI.Action.TextColor3 = Theme.Dim
        else
            UI.Action.BackgroundColor3 = Theme.Accent
            UI.Action.TextColor3 = Color3.new(1, 1, 1)
        end
    end

    local function refreshMicBadge()
        local muted = getMicState()
        if muted == true then
            UI.MicDot.BackgroundColor3 = Theme.Bad
            UI.MicLabel.Text = "mic muted — unmute first"
            UI.MicLabel.TextColor3 = Theme.Bad
        elseif muted == false then
            UI.MicDot.BackgroundColor3 = Theme.Good
            UI.MicLabel.Text = "mic unmuted"
            UI.MicLabel.TextColor3 = Theme.Good
        else
            UI.MicDot.BackgroundColor3 = Theme.Warn
            UI.MicLabel.Text = "mic not detected"
            UI.MicLabel.TextColor3 = Theme.Warn
        end
        return muted
    end

    local function startBypass()
        if State.Loaded or State.Active or State.Loading then return end
        local muted = getMicState()
        refreshMicBadge()
        if muted == true then
            State.WaitingForUnmute = true
            setStatus("unmute first", Theme.Bad)
            setButton("unmute first", false)
            return
        end
        State.Loading = true
        State.WaitingForUnmute = false
        setStatus("starting…", Theme.Warn)
        setButton("working…", false)
        if UI.ProtDot then UI.ProtDot.BackgroundColor3 = Theme.Warn end
        if UI.ProtLabel then
            UI.ProtLabel.Text = "starting…"
            UI.ProtLabel.TextColor3 = Theme.Warn
        end

        task.spawn(function()
            local ok, err = pcall(runBypass)
            State.Loading = false
            if not ok then
                setStatus("failed: " .. tostring(err):sub(1, 60), Theme.Bad)
                setButton("Try again", true)
                State.Loaded = false
                State.Active = false
                if UI.ProtDot then UI.ProtDot.BackgroundColor3 = Theme.Bad end
                if UI.ProtLabel then
                    UI.ProtLabel.Text = "failed"
                    UI.ProtLabel.TextColor3 = Theme.Bad
                end
                return
            end
            if State.Closed then return end
            State.Loaded = true
            State.Active = true
            applyActiveTheme()
            notify("amen on — don't mute", 4)
        end)
    end

    action.MouseButton1Click:Connect(startBypass)

    task.spawn(function()
        while gui.Parent and not State.Closed do
            if State.Active or State.Loaded then
                task.wait(2)
            elseif not State.Loading then
                local m = getMicState()
                refreshMicBadge()
                if State.WaitingForUnmute and m == false then
                    State.WaitingForUnmute = false                    setStatus("unmuted — starting…", Theme.Good)
                    task.wait(3)
                    startBypass()
                end
                task.wait(0.75)
            else
                task.wait(0.5)
            end
        end
    end)

    refreshMicBadge()
end

-- ============ AUTO START SPEED ============
startSpeedLoop()

