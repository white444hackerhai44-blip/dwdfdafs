-- ============ SPEED SYSTEM ============
local speedConn
local function applySpeed()
    if not State.SpeedEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.WalkSpeed = State.SpeedValue
    hum.JumpPower = 50
end

local function startSpeedLoop()
    if speedConn then speedConn:Disconnect() end
    applySpeed()
    speedConn = RunService.Heartbeat:Connect(function()
        if not State.SpeedEnabled then return end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed ~= State.SpeedValue then
                hum.WalkSpeed = State.SpeedValue
            end
        end
    end)
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        applySpeed()
    end)
end

-- ============ MIC BUTTON FINDER ============
local function findMicButton()
    local names = {
        "toggle_mic_mute", "toggle_mic_mute_new", "mic_mute",
        "MicrophoneButton", "VoiceChatButton", "UnmuteMic",
    }
    local roots = { CoreGui }
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then table.insert(roots, h) end
    end
    table.insert(roots, PlayerGui)

    for _, root in ipairs(roots) do
        for _, name in ipairs(names) do
            local found
            pcall(function() found = root:FindFirstChild(name, true) end)
            if found then return found end
        end
        local match
        pcall(function()
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    local n = string.lower(d.Name)
                    if n:find("mic") or n:find("voice") then
                        match = d; break
                    end
                end
            end
        end)
        if match then return match end
        local hitArea
        pcall(function()
            for _, d in ipairs(root:GetDescendants()) do
                local n = string.lower(d.Name)
                if n:find("iconhitarea") and (n:find("mic") or n:find("voice")) then
                    hitArea = d.Parent or d; break
                end
            end
        end)
        if hitArea then return hitArea end
    end
    return nil
end

local function findUnibarContainer(micBtn)
    if not micBtn then return nil end
    return micBtn.Parent
end

local function iconLabel(btn)
    if not btn then return nil end
    local r
    pcall(function()
        local frame = btn:FindFirstChild("IntegrationIconFrame", true)
        if frame then
            local icon = frame:FindFirstChild("IntegrationIcon", true)
            if icon then r = icon:FindFirstChild("1") or icon:FindFirstChildWhichIsA("ImageLabel") end
        end
    end)
    if not r then pcall(function() r = btn:FindFirstChildWhichIsA("ImageLabel", true) end) end
    return r
end

-- ============ MIC STATE ============
local micCache, micCacheAt = nil, 0
local function readMicFromUI()
    if tick() - micCacheAt < 1.25 and micCache ~= nil then return micCache end
    local foundMuted, foundUnmuted = false, false
    pcall(function()
        local top = CoreGui:FindFirstChild("TopBarApp")
        local roots = top and { top } or { CoreGui }
        for _, root in ipairs(roots) do
            for _, ui in ipairs(root:GetDescendants()) do
                if ui:IsA("ImageLabel") or ui:IsA("ImageButton") then
                    local img = string.lower(tostring(ui.Image or ""))
                    if img:find("voicechat") and img:find("mic") then
                        if img:find("unmuted") then foundUnmuted = true
                        elseif img:find("muted") then foundMuted = true
                        elseif img:find("miclight") or img:find("mic_light") then foundUnmuted = true end
                    end
                end
            end
        end
    end)
    local result
    if foundUnmuted and not foundMuted then result = false
    elseif foundMuted and not foundUnmuted then result = true end
    micCache, micCacheAt = result, tick()
    return result
end

local function getMicState()
    local muted
    pcall(function()
        local adi = LocalPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true)
        if adi then
            if adi.Muted == true or adi.Active == false then muted = true; return end
            if adi.Muted == false and adi.Active ~= false then muted = false; return end
        end
    end)
    if type(muted) == "boolean" then return muted, "api" end
    pcall(function()
        if VoiceChatInternal and typeof(VoiceChatInternal.IsMuted) == "function" then
            local m = VoiceChatInternal:IsMuted()
            if type(m) == "boolean" then muted = m end
        end
    end)
    if type(muted) == "boolean" then return muted, "api" end
    local fromUi = readMicFromUI()
    if type(fromUi) == "boolean" then return fromUi, "ui" end
    return nil, nil
end

local function setMicState(muted)
    local adi = LocalPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true)
    if adi then
        adi.Active = not muted
        if adi.Muted ~= nil then adi.Muted = muted end
    else
        pcall(function() VoiceChatInternal:PublishPause(muted) end)
    end
end

-- ============ CORE BYPASS ============
local function runBypass()
    local isMuted = true
    local hidden = Instance.new("Folder")
    hidden.Name = "Amen_VC_Hidden"
    pcall(function() hidden.Parent = game:GetService("RobloxReplicatedStorage") end)

    local micButton = findMicButton()
    if not micButton then
        pcall(function() VoiceChatService:joinVoice() end)
        task.wait(3)
        micButton = findMicButton()
    end
    if not micButton then
        notify("can't find mic button", 6)
        return false
    end

    local container = findUnibarContainer(micButton)
    task.wait(2)

    local deadline = tick() + 60
    while tick() < deadline and not State.Closed do
        local icon = iconLabel(micButton)
        local imgOk = false
        pcall(function()
            if icon and icon.Image ~= mutedImage then imgOk = true end
        end)
        if imgOk then break end
        if getMicState() == false then break end
        task.wait(0.5)
    end
    if State.Closed then return false end

    pcall(function() VoiceChatService:leaveVoice() end)
    task.wait(2)

    local disabled = 0
    pcall(function()
        if not getConnFn or not VoiceChatInternal then return end
        local conns = getConnFn(VoiceChatInternal.StateChanged)
        for i = 7, #conns do
            if conns[i] then pcall(function() conns[i]:Disable(); disabled += 1 end) end
        end
    end)

    task.wait(2)
    pcall(function() VoiceChatService:joinVoice() end)
    task.wait(2)

    micButton = findMicButton()
    container = findUnibarContainer(micButton)

    if micButton and container then
        pcall(function()
            local cloned = micButton:Clone()
            micButton.Parent = hidden
            cloned.Name = "toggle_mic_mute_new"
            cloned.Parent = container
            local clonedIcon = iconLabel(cloned)
            local origIcon = iconLabel(micButton)
            setMicState(true)
            local hit = cloned:FindFirstChild("IconHitArea_toggle_mic_mute", true)
                or cloned:FindFirstChildWhichIsA("TextButton", true)
                or cloned:FindFirstChildWhichIsA("ImageButton", true)
                or cloned
            if hit then
                hit.Activated:Connect(function()
                    isMuted = not isMuted
                    setMicState(isMuted)
                    if isMuted then
                        if clonedIcon then clonedIcon.Image = mutedImage end
                    else
                        if clonedIcon and origIcon then clonedIcon.Image = origIcon.Image end
                    end
                end)
            end
        end)
    end

    local reconnected = false
    local deadline2 = tick() + 20
    local conn
    pcall(function()
        if VoiceChatInternal and VoiceChatInternal.StateChanged then
            conn = VoiceChatInternal.StateChanged:Connect(function(_, new)
                local n = string.lower(tostring(new and (new.Name or new) or ""))
                if n:find("join") or n:find("connect") or n:find("ingame")
                    or n:find("active") or n:find("joined") then
                    reconnected = true
                end
            end)
        end
    end)

    while tick() < deadline2 and not reconnected and not State.Closed do
        pcall(function()
            local st = VoiceChatInternal and VoiceChatInternal.VoiceChatState
            if st then
                local n = string.lower(tostring(st.Name or st))
                if n:find("join") or n:find("connect") or n:find("ingame") or n:find("joined") then
                    reconnected = true
                end
            end
        end)
        if not reconnected then
            pcall(function()
                local adi = LocalPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true)
                if adi and adi.Active ~= nil then reconnected = true end
            end)
        end
        task.wait(0.2)
    end
    if conn then conn:Disconnect() end
    if State.Closed then return false end
    return true
end

